#!/bin/sh
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if echo "$remote_ref" | grep -q "^refs/tags/v"; then
    echo >&2 ""
    echo >&2 "  ERROR: Do not push release tags manually."
    echo >&2 ""
    echo >&2 "  This repo creates version tags in the Release workflow only."
    echo >&2 "  Use the Release workflow instead:"
    echo >&2 "    1. Merge conventional-commit PRs (feat:/fix:/feat!:) to main"
    echo >&2 "       (or keep a CI-green branch for prereleases)"
    echo >&2 "    2. Dispatch the Release workflow (Actions -> Release -> Run)"
    echo >&2 "       - stable: from main"
    echo >&2 "       - prerelease: from the CI-green branch"
    echo >&2 "    3. semantic-release computes the version and pushes the tag"
    echo >&2 ""
    exit 1
  fi
done
exit 0
